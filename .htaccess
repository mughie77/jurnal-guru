RewriteEngine On
Options -MultiViews -Indexes

# 1. Redirect index.php to directory root (e.g. /index.php -> / or /guru/index.php -> /guru/)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/*(.*)/index\.php[\s?] [NC]
RewriteRule ^ %1/ [R=301,L]

# 2. Redirect external requests for *.php to extensionless URLs (e.g. /login.php -> /login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Exclude existing static files (e.g. css, js, png, jpg) and directories
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !\.php$
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Internal Rewrite: Map extensionless URL to .php file if it exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L,QSA]

# 5. Error Documents (Path Relatif)
ErrorDocument 403 error/403.php
ErrorDocument 404 error/404.php
ErrorDocument 500 error/500.php
ErrorDocument 503 error/503.php
